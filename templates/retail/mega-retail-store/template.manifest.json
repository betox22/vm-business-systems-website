{
  "id": "mega_retail_store",
  "name": "Mega Retail Store",
  "version": "0.1.0",
  "runtimeEnabled": true,
  "phaseStatus": "visual_prototype",
  "category": "retail",
  "commerceCapabilitiesRef": "../../commerce-capabilities.json",
  "commerceProfileId": "mega-retail-store",
  "commerceModel": {
    "salesEnabled": true,
    "ownershipModel": "single_owner",
    "inventoryModel": "owned_inventory",
    "checkoutModel": "single_store_checkout",
    "orderSplitRequired": false,
    "supportsPayments": true,
    "supportsShippingTracking": true,
    "supportsCustomerAccounts": true,
    "supportsStoreAdmin": true
  },
  "runtime": {
    "type": "static_visual_prototype",
    "previewPath": "./phase-5/visual-prototype/preview.html",
    "stylePath": "./phase-5/visual-prototype/styles.css",
    "scriptPath": "./phase-5/visual-prototype/prototype.js"
  },
  "referenceAssets": [
    "/templates-preview/carousel-assets/amazon_2.jpg"
  ],
  "implementedPages": [
    "home",
    "catalog",
    "product_detail",
    "cart",
    "checkout"
  ],
  "missingPages": [
    "customer_account",
    "store_admin_inventory"
  ],
  "legalNaming": {
    "thirdPartyBrandReferencesAllowed": false,
    "blockedPublicTerms": [
      "third_party_marketplace_brand_names",
      "third_party_store_builder_brand_names"
    ],
    "internalDirection": "High-density single-owner retail catalog"
  },
  "bestFor": [
    "broad_catalog",
    "single_vendor",
    "owned_inventory",
    "search_first_shopping",
    "deals_and_categories",
    "online_checkout",
    "customer_accounts",
    "store_admin_inventory"
  ],
  "notFor": [
    "multi_vendor",
    "external_sellers",
    "seller_onboarding",
    "vendor_payouts",
    "classified_listings",
    "single_product_showcase",
    "restaurant_menu_only",
    "appointment_booking_only",
    "simple_company_brochure",
    "portfolio_only"
  ],
  "requiredPages": [
    {
      "id": "home",
      "purpose": "Search-first retail landing page with departments, deals, product rails, and trust signals."
    },
    {
      "id": "catalog",
      "purpose": "Filterable owned product catalog with categories, search, sorting, price filters, ratings, and product cards."
    },
    {
      "id": "product_detail",
      "purpose": "Product detail page with gallery, price, shipping, variants, reviews, and add-to-cart."
    },
    {
      "id": "cart",
      "purpose": "Single-owner cart showing items, shipping estimate, tax estimate, and checkout readiness."
    },
    {
      "id": "checkout",
      "purpose": "Secure checkout flow for one store order with inventory, tax, shipping, and payment validation."
    },
    {
      "id": "customer_account",
      "purpose": "Customer orders, addresses, profile, saved items, and support."
    },
    {
      "id": "store_admin_inventory",
      "purpose": "Owner product management, inventory, promotions, categories, and order status."
    }
  ],
  "requiredSections": [
    "retail_header",
    "global_search_bar",
    "department_navigation",
    "hero_deal_band",
    "category_tiles",
    "deal_rail",
    "recommended_product_grid",
    "owned_inventory_trust_strip",
    "newsletter_or_account_cta",
    "retail_footer"
  ],
  "dataContracts": {
    "productCard": {
      "required": [
        "id",
        "sku",
        "name",
        "category",
        "price",
        "currency",
        "rating",
        "reviewCount",
        "imageUrl",
        "inventoryStatus",
        "shippingBadge"
      ],
      "optional": [
        "brand",
        "collection",
        "discountLabel",
        "variantOptions"
      ]
    },
    "cart": {
      "required": [
        "items",
        "subtotal",
        "shippingEstimate",
        "taxEstimate",
        "checkoutEligible"
      ]
    },
    "order": {
      "required": [
        "id",
        "customerId",
        "orderNumber",
        "status",
        "subtotal",
        "shippingAmount",
        "taxAmount",
        "total"
      ]
    }
  },
  "aiUsageRules": [
    "AI may choose copy, ordering, category labels, product descriptions, visual tone, and product grouping.",
    "AI must not invent unsupported component types.",
    "AI must not output raw HTML, raw JavaScript, or arbitrary CSS.",
    "AI must produce structured JSON that conforms to the template data contracts.",
    "AI must preserve the selected template family unless the user explicitly asks to change it.",
    "AI must use this template for broad catalogs managed by one owner, not for external vendor marketplaces.",
    "AI must adapt the store to the client business instead of pasting client notes directly into the page."
  ],
  "securityControlsRef": "./contracts/security-controls.json"
}
