  "globalRules": [
    "A Mega Marketplace site must be search-first and catalog-first.",
    "Every commerce screen must have loading, error, and empty/blocked states where applicable.",
    "Cart and checkout must show vendor grouping.",
    "Frontend estimates are never final totals.",
    "Backend quote owns final prices, stock, shipping, tax, and checkout eligibility.",
    "Frontend must not expose vendor or admin-only controls on public screens.",
    "Vendor screens must be scoped to authenticated vendor id.",
    "Admin screens must require admin role and audit sensitive mutations.",
    "Mobile layouts must keep search, cart, and primary action visible without horizontal scrolling."
  ]
