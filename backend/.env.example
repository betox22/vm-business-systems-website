# Stripe test mode first. Never commit real secret values.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Separate webhook destinations keep the ledgers explicit.
STRIPE_STORE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_BILLING_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me

# Recurring Prices created in Stripe test mode.
STRIPE_KREATON_MONTHLY_PRICE_ID=price_replace_me
STRIPE_LISTO_POS_MONTHLY_PRICE_ID=price_replace_me
STRIPE_LISTO_KDS_MONTHLY_PRICE_ID=price_replace_me

# Optional application fee on each connected-store order. Default is zero.
STRIPE_CONNECT_APPLICATION_FEE_BPS=0

# Safe Stripe-hosted onboarding return locations.
STRIPE_CONNECT_REFRESH_URL=https://vmbusinesssystems.com/client/portal/
STRIPE_CONNECT_RETURN_URL=https://vmbusinesssystems.com/client/portal/

# Server-to-server credential used only by the separate Listo service.
LISTO_BILLING_API_KEY=replace_with_a_long_random_value
